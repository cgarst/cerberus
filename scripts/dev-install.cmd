@echo off
setlocal
set "BUILD_INSTALLER=%~dp0build-installer.ps1"
set "SETUP_EXE=%~dp0..\build\CerberusServiceSetup.exe"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$buildScript = $env:BUILD_INSTALLER; $setupExe = $env:SETUP_EXE; $cmd = 'try { $ErrorActionPreference = ''Stop''; & ''' + $buildScript.Replace('''', '''''') + ''' -SkipChecks; Write-Host ''''; Write-Host ''Stopping CerberusService...'' -ForegroundColor Cyan; Start-Process -FilePath ''schtasks.exe'' -ArgumentList @(''/End'', ''/TN'', ''CerberusService'') -WindowStyle Hidden -Wait; Stop-Process -Name CerberusService -Force -ErrorAction SilentlyContinue; Wait-Process -Name CerberusService -ErrorAction SilentlyContinue; Write-Host ''Running CerberusServiceSetup.exe...'' -ForegroundColor Cyan; $logFile = Join-Path $env:TEMP ''CerberusServiceSetup.log''; $p = Start-Process -FilePath ''' + $setupExe.Replace('''', '''''') + ''' -ArgumentList @(''/SILENT'', ''/SUPPRESSMSGBOXES'', ''/NORESTART'', ''/MERGETASKS=autostart'', (''/LOG='' + $logFile)) -PassThru; $p.WaitForExit(); if ($p.ExitCode -ne 0) { throw (''Installer failed with exit code '' + $p.ExitCode + '' (see '' + $logFile + '')'') }; schtasks.exe /Run /TN CerberusService | Out-Null; Write-Host ''CerberusServiceSetup.exe completed and CerberusService started.'' -ForegroundColor Green; Write-Host ''''; Write-Host ''Done! Closing in 5 seconds...'' -ForegroundColor Green; Start-Sleep -Seconds 5 } catch { Write-Host ''''; Write-Host $_ -ForegroundColor Red; Read-Host ''Press Enter to close''; exit 1 }'; Start-Process powershell.exe -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $cmd)"
