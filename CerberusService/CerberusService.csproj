<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CerberusService</AssemblyName>
    <RootNamespace>RoomAgent</RootNamespace>
    <ApplicationIcon>Cerberus.ico</ApplicationIcon>
    <ApplicationManifest>CerberusService.exe.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>CerberusService</Product>
    <Description>Cerberus Service for display, audio, and room automation</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Cerberus.ico" LogicalName="Cerberus.ico" />
    <EmbeddedResource Include="WebUI\**" LogicalName="WebUI/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
</Project>
